theory PQAKE_phase1_replay_fixed
begin

/* -------------------------------------------------------------------------
 * P.Q.A.K.E. v1 - phase 1 AFTER the F2 repair: eq 4-6a, the freshness test B
 * never had.  Tamarin port of model/pqake_replay_fixed.pv; identical to
 * pqake.spthy rule for rule except for the SeenM1 fact emitted by B_accept, the
 * one_accept_per_M1 restriction over it, and the extra probe lemmas that test
 * whether that restriction bites.
 *
 * Run:  tamarin-prover --prove pqake_replay_fixed.spthy
 *       (in CI: .github/workflows/tamarin.yml; transcripts land in
 *        model/logs/pqake_replay_fixed.tamarin.log)
 * Read: model/ACCE-PQAKE.md, FINDINGS.md (finding F2)
 *
 * Modelling decisions - one for one with model/pqake.pv, so that the two tools
 * can be compared lemma by lemma:
 *
 *   - The IBS of eq 4-1..4-4 is idealised as a deterministic EUF-CMA signature
 *     scheme (built-in theory `signing`).  Identity-based key derivation
 *     (usk = h_ID * s1) is ring arithmetic and cannot be expressed in a free
 *     algebra, so the master-secret break F1 and the escrow claim D1 are
 *     neither provable nor refutable here; they are established executably
 *     (lab/claims.py::c2, ::d1) and symbolically only in pqake_pkg_escrow.pv.
 *   - ML-KEM-512 (FIPS 203) is an IND-CCA KEM, idealised exactly as the
 *     ProVerif model idealises it (reduc
 *     kemDecap(kemEncap(s0, kemPK(k)), k) = s0): encapsulation draws a fresh
 *     secret and emits a ciphertext that only the matching secret key
 *     recovers, so it is the built-in asymmetric-encryption theory - the
 *     ciphertext is aenc{ ss0 }pkAe and decapsulation is pattern matching
 *     under pk(skAe).  FIPS 203's implicit rejection is the case where the
 *     pattern does not match: the rule simply cannot be applied.
 *   - SHA3-256, HKDF and HMAC are free constructors: no equations, so equality
 *     of two derived terms forces equality of their inputs (random-oracle
 *     idealisation, same as ProVerif's one-way constructors).
 *   - na, skAe and ss0 are fresh names, i.e. the model gives the protocol every
 *     nonce and ephemeral key it asks for.  What it does NOT give B is any
 *     means of noticing that an M1 it has already accepted is being handed to
 *     it again - which is finding F2.

 In THIS file the cache is eq 4-6a: B remembers every (ID_A, NA) pair it has
 accepted and refuses a second one.  ProVerif cannot use the negative branch of
 a table read to prove injectivity (model/limitation_table_else.pv reproduces
 that limitation), so it reports Q3 false here for a reason that is an artefact
 of the tool rather than of the protocol.  Tamarin reasons about trace
 invariants, which is what this port is for: if eq 4-6a really does rule the
 replay out, Q3 and no_double_accept must come back verified.
 *   - Long-term identity keys are honest by construction: PKG_gen is the only
 *     rule that creates them, no rule ever outputs one (so there is no reveal
 *     oracle here, mirroring `free uskA/uskB` in the ProVerif process and the
 *     "honest long-term keys" row of table 5-5), and one_key_per_identity keeps
 *     the model to the single key pair the ProVerif process has.
 * ------------------------------------------------------------------------- */

builtins: signing, symmetric-encryption, asymmetric-encryption

/* ---------- SHA3-256 / HKDF / HMAC (eq 4-11 .. 4-20) ---------- */

functions:
  hkSalt/4,      //  salt = H(IDA | IDB | NA | NB)                       eq 4-12
  hkExtract/2,   //  PRK0 = Extract(salt, ss0)                           eq 4-13
  hkExpand/2,    //  Kconf, Ksess                                        eq 4-14..4-19
  macOf/2,       //  HMAC over the transcript                            eq 4-20
  confOf/2,      //  th1 = H(TH | MACB), the input of MACA               eq 4-20
  transOf/8      //  TH  = H(IDA|IDB|NA|NB|pkAe|ct0|sigmaA|sigmaB)       eq 4-11

/* no equations: every symbol above is a free constructor */

/* ---------- PKG: one honest identity key per role (eq 4-1..4-4) ---------- */

rule PKG_gen:
  [ Fr( ~uskA ), Fr( ~uskB) ]
  --[ LtkGen( 'A', ~uskA ), LtkGen( 'B', ~uskB ) ]->
  [ !Ltk( 'A', ~uskA ), !Ltk( 'B', ~uskB ) ]

restriction one_key_per_identity:
  "All id k1 k2 #i #j.
     LtkGen( id, k1 ) @ i & LtkGen( id, k2 ) @ j
     ==>
     #i = #j"

/* eq 4-6a read as a trace invariant: no M1 is accepted twice.  ProVerif's
   equivalent is "get seenM1(=A,=NA) in ... else insert seenM1(A, NA)", whose
   else-branch it cannot tie back to the insert.

   SeenM1 is an ACTION fact, i.e. an annotation on the step that accepts M1, not
   a fact stored in B's state.  That is deliberate.  Declared as a stored fact
   (post-premise) the restriction was registered - the transcript prints it as a
   "safety formula", and the seen_once lemma restating it was verified - yet the
   1.12 solver still returned a double-accept counterexample for
   no_double_accept (11 steps, two PKG_gen instances, SeenM1( na ) written
   twice), i.e. a trace that violates one_accept_per_M1 and one_key_per_identity
   at once.  model/RestrictionProbeBefore.spthy shows a stored-fact restriction
   being enforced in a 3-rule theory, so the gap is the interaction with the
   rule's KU-derived premises, not the syntax.  Stating the invariant over the
   fact the lemmas themselves quantify over removes the gap, and the lemmas
   below then have to derive injectivity from it rather than assume it. */
restriction one_accept_per_M1:
  "All na #i #j.
     SeenM1( na ) @ i & SeenM1( na ) @ j
     ==>
     #i = #j"

/* The two payloads the test session protects (ProVerif: free payloadA/payloadB). */
rule Test_payloads:
  [ Fr( ~pA ), Fr( ~pB ) ]
  --[ CreatedPayload( 'A', ~pA ), CreatedPayload( 'B', ~pB ) ]->
  [ !Test( 'A', ~pA ), !Test( 'B', ~pB ) ]

/* ---------- initiator A: eq 4-4, 4-5 ---------- */

rule A_start:
  let pkAe = pk( ~skAe )
      m1   = < 'A', 'B', pkAe, ~na, sign{ 'A', 'B', pkAe, ~na }~uskA >
  in
    [ Fr( ~na )
    , Fr( ~skAe )
    , !Ltk( 'A', ~uskA )
    ]
  --[ StartA( ~na, pkAe ) ]->
    [ Out( m1 )
    , StA( ~na, ~skAe )
    ]

/* ---------- responder B: eq 4-6, 4-7, 4-8, and B's half of 4-11..4-20 ---------- */

rule B_accept:
  let ct0   = aenc{ ~ss }pkAe
      sigA  = sign{ 'A', 'B', pkAe, na }~uskA
      sigB  = sign{ 'B', 'A', ~nb, ct0, na }~uskB
      th    = transOf( 'A', 'B', na, ~nb, pkAe, ct0, sigA, sigB )
      prk   = hkExtract( hkSalt( 'A', 'B', na, ~nb ), ~ss )
      kconf = hkExpand( prk, <'Kconf', th> )
      m1    = < 'A', 'B', pkAe, na, sigA >
      m2    = < ~nb, ct0, sigB >
  in
    [ In( m1 )
    , !Ltk( 'A', ~uskA )
    , !Ltk( 'B', ~uskB )
    , Fr( ~nb )
    , Fr( ~ss )
    ]
  --[ AcceptB( na, pkAe, ~nb ), SeenM1( na ) ]->
    [ Out( m2 )
    , Out( macOf( kconf, th ) )
    , StB( na, pkAe, ~nb, ~ss )
    ]

/* ---------- B: MACA check, eq 4-20; then the first protected message ---------- */

rule B_finish:
  let ct0   = aenc{ ss }pkAe
      sigA  = sign{ 'A', 'B', pkAe, na }~uskA
      sigB  = sign{ 'B', 'A', nb, ct0, na }~uskB
      th    = transOf( 'A', 'B', na, nb, pkAe, ct0, sigA, sigB )
      prk   = hkExtract( hkSalt( 'A', 'B', na, nb ), ss )
      kconf = hkExpand( prk, <'Kconf', th> )
      ksess = hkExpand( prk, <'Ksess', th> )
      macB  = macOf( kconf, th )
      macA  = macOf( kconf, confOf( th, macB ) )
  in
    [ StB( na, pkAe, nb, ss )
    , !Ltk( 'A', ~uskA )
    , !Ltk( 'B', ~uskB )
    , !Test( 'B', pB )
    , In( macA )
    ]
  --[ DoneB( na, nb, ksess ) ]->
    [ Out( senc{ 'B', pB }ksess )
    ]

/* ---------- initiator A: eq 4-9, 4-10, 4-11..4-20 ---------- */

rule A_finish:
  let pkAe  = pk( skAe )
      ct0   = aenc{ ss0 }pkAe
      sigA  = sign{ 'A', 'B', pkAe, na }~uskA
      sigB  = sign{ 'B', 'A', nb, ct0, na }~uskB
      th    = transOf( 'A', 'B', na, nb, pkAe, ct0, sigA, sigB )
      prk   = hkExtract( hkSalt( 'A', 'B', na, nb ), ss0 )
      kconf = hkExpand( prk, <'Kconf', th> )
      ksess = hkExpand( prk, <'Ksess', th> )
      macB  = macOf( kconf, th )
      m2    = < nb, ct0, sigB >
  in
    [ StA( na, skAe )
    , !Ltk( 'A', ~uskA )
    , !Ltk( 'B', ~uskB )
    , !Test( 'A', pA )
    , In( m2 )
    , In( macB )
    ]
  --[ DoneA( na, nb, ksess ) ]->
    [ Out( macOf( kconf, confOf( th, macB ) ) )
    , Out( senc{ 'A', pA }ksess )
    ]

/* =========================================================================
 * Properties - the queries of pqake.pv, plus a consistency check so that a
 * vacuous "holds" cannot be mistaken for a proof.
 * ======================================================================= */

/* Q1 secrecy of what the session key protects, for both roles */
lemma payload_secrecy:
  "All who p #i.
     CreatedPayload( who, p ) @ i
     ==>
     not( Ex #k. K( p ) @ k )"

/* Q2 aliveness: whatever B accepts was started by A with the same NA and pkAe */
lemma aliveness:
  "All na pkAe nb #i.
     AcceptB( na, pkAe, nb ) @ i
     ==>
     ( Ex #j. StartA( na, pkAe ) @ j & j < i )"

/* Q3 injective agreement: one accepted M1 cannot be spent twice.
      This is the statement ProVerif could not decide for the repaired
      handshake; see FINDINGS.md F2 and model/limitation_table_else.pv. */
lemma injective_agreement [use_induction]:
  "All na pkAe nb #i.
     AcceptB( na, pkAe, nb ) @ i
     ==>
     ( Ex #j. StartA( na, pkAe ) @ j & j < i
       & not( Ex nb2 #i2. AcceptB( na, pkAe, nb2 ) @ i2 & not( #i = #i2 ) ) )"

/* The second conjunct of Q3 on its own: this is the lemma that tests whether
   one_accept_per_M1 is actually enforced. */
lemma no_double_accept [use_induction]:
  "All na pkAe nb1 nb2 #i #j.
     AcceptB( na, pkAe, nb1 ) @ i & AcceptB( na, pkAe, nb2 ) @ j
     ==>
     #i = #j"

/* Restating one_accept_per_M1 as a lemma.  If this is falsified the restriction
   is not constraining the search at all, and no verdict below can be read as
   evidence about eq 4-6a. */
lemma seen_once:
  "All na #i #j.
     SeenM1( na ) @ i & SeenM1( na ) @ j
     ==>
     #i = #j"

/* The marker is written exactly when - and only when - B accepts, so the
   invariant above really is about accepted M1s and not about an unused fact. */
lemma accept_emits_seen:
  "All na pkAe nb #i.
     AcceptB( na, pkAe, nb ) @ i
     ==>
     ( Ex #j. SeenM1( na ) @ j & #i = #j )"

/* Both statements above proved without the use_induction attribute.  The
   counterexample 1.12 returned for the inductive versions uses two PKG_gen
   instances (two long-term keys for identity 'A') and emits SeenM1( na ) twice,
   so it violates one_key_per_identity and one_accept_per_M1 at once - see
   model/RestrictionProbeBefore.spthy for the minimal experiment.  If these two
   come back verified while the inductive versions are falsified, the tool's
   handling of restrictions under induction is the whole explanation, and the
   verdict to report for eq 4-6a is the non-inductive one. */
lemma no_double_accept_plain:
  "All na pkAe nb1 nb2 #i #j.
     AcceptB( na, pkAe, nb1 ) @ i & AcceptB( na, pkAe, nb2 ) @ j
     ==>
     #i = #j"

lemma injective_agreement_plain:
  "All na pkAe nb #i.
     AcceptB( na, pkAe, nb ) @ i
     ==>
     ( Ex #j. StartA( na, pkAe ) @ j & j < i
       & not( Ex nb2 #i2. AcceptB( na, pkAe, nb2 ) @ i2 & not( #i = #i2 ) ) )"

/* Q4 key authentication in the direction the channel can support */
lemma key_authentication:
  "All na nb ks #i.
     DoneB( na, nb, ks ) @ i
     ==>
     ( Ex #j. DoneA( na, nb, ks ) @ j & j < i )"

/* Q5 the same, injective: one finished B session per finished A session */
lemma key_authentication_inj [use_induction]:
  "All na nb ks #i.
     DoneB( na, nb, ks ) @ i
     ==>
     ( Ex #j. DoneA( na, nb, ks ) @ j & j < i
       & not( Ex #k. DoneB( na, nb, ks ) @ k & not( #i = #k ) ) )"

/* Q6 aliveness of B for A's view: A can only finish if B accepted that very M1 */
lemma responder_aliveness:
  "All na nb ks #i.
     DoneA( na, nb, ks ) @ i
     ==>
     ( Ex #j pkAe. AcceptB( na, pkAe, nb ) @ j )"

/* Consistency check: the lemmas above are not vacuous - honest sessions do
   complete, and both sides derive the same Ksess. */
lemma handshake_possible:
  exists-trace
  "Ex na nb ks #i #j.
     DoneA( na, nb, ks ) @ i & DoneB( na, nb, ks ) @ j"

/* Controls, so that the verdict on Q3 cannot be an artefact of a rule set that
   simply has no traces.  Both are existence statements, so "falsified - no trace
   found" is a real result and not a vacuous "verified".

   replay_trace_excluded: the F2 replay - one M1 accepted twice.  pqake.spthy
   proves this exists (that is finding F2 as a Tamarin trace); here it must not.
   two_ltk_excluded: two long-term keys issued to identity 'A'.  Must not exist
   in either theory, which is what makes the single-honest-key reading of
   pqake.pv's `new uskA` the one the proofs see. */
lemma replay_trace_excluded:
  exists-trace
  "Ex na pkAe nb1 nb2 #i #j.
     AcceptB( na, pkAe, nb1 ) @ i & AcceptB( na, pkAe, nb2 ) @ j
     & not( #i = #j )"

lemma two_ltk_excluded:
  exists-trace
  "Ex k1 k2 #i #j.
     LtkGen( 'A', k1 ) @ i & LtkGen( 'A', k2 ) @ j & not( #i = #j )"

end
