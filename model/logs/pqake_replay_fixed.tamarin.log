  /* has exactly the trivial AC variant */

lemma payload_secrecy:
  all-traces
  "∀ who p #i. (CreatedPayload( who, p ) @ #i) ⇒ (¬(∃ #k. K( p ) @ #k))"
/*
guarded formula characterizing all counter-examples:
"∃ who p #i. (CreatedPayload( who, p ) @ #i) ∧ ∃ #k. (K( p ) @ #k)"
*/
simplify
solve( CreatedPayload( who, p ) @ #i )
  case Test_payloads_case_1
  solve( !KU( ~pA ) @ #vk )
    case A_finish
    solve( !KU( sign(<'B', 'A', nb, aenc(ss0, pk(~skAe)), ~na>, ~uskB)
           ) @ #vk.10 )
      case B_accept
      solve( !KU( ~ss ) @ #vk.13 )
        case B_accept
        by solve( !KU( ~skAe ) @ #vk.23 )
      qed
    next
      case c_sign
      by solve( !KU( ~uskB ) @ #vk.23 )
    qed
  qed
next
  case Test_payloads_case_2
  solve( !KU( ~pB ) @ #vk )
    case B_finish
    solve( !KU( ~ss ) @ #vk.17 )
      case B_accept
      solve( !KU( sign(<'A', 'B', pk(x), na>, ~uskA) ) @ #vk.16 )
        case A_start
        by solve( !KU( ~skAe ) @ #vk.21 )
      next
        case c_sign
        by solve( !KU( ~uskA ) @ #vk.25 )
      qed
    qed
  qed
qed

lemma aliveness:
  all-traces
  "∀ na pkAe nb #i.
    (AcceptB( na, pkAe, nb ) @ #i) ⇒
    (∃ #j. (StartA( na, pkAe ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ na pkAe nb #i.
  (AcceptB( na, pkAe, nb ) @ #i)
 ∧
  ∀ #j. (StartA( na, pkAe ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !Ltk( 'A', ~uskA ) ▶₁ #i )
  case PKG_gen
  solve( !Ltk( 'B', ~uskB ) ▶₂ #i )
    case PKG_gen
    solve( !KU( sign(<'A', 'B', pkAe, na>, ~uskA) ) @ #vk.8 )
      case A_start
      by contradiction /* from formulas */
    next
      case c_sign
      by solve( !KU( ~uskA ) @ #vk.12 )
    qed
  qed
qed

lemma injective_agreement [use_induction]:
  all-traces
  "∀ na pkAe nb #i.
    (AcceptB( na, pkAe, nb ) @ #i) ⇒
    (∃ #j.
      ((StartA( na, pkAe ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ nb2 #i2. (AcceptB( na, pkAe, nb2 ) @ #i2) ∧ (¬(#i = #i2)))))"
/*
guarded formula characterizing all counter-examples:
"∃ na pkAe nb #i.
  (AcceptB( na, pkAe, nb ) @ #i)
 ∧
  ∀ #j.
   (StartA( na, pkAe ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ nb2 #i2. (AcceptB( na, pkAe, nb2 ) @ #i2) ∧ ¬(#i = #i2)))"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (last(#i))  ∥
         (∃ #j.
           (StartA( na, pkAe ) @ #j)
          ∧
           (¬(last(#j))) ∧
           (#j < #i) ∧
           (∀ nb2 #i2.
             (AcceptB( na, pkAe, nb2 ) @ #i2) ⇒ ((last(#i2)) ∨ (#i = #i2)))) )
    case case_1
    solve( !Ltk( 'A', ~uskA ) ▶₁ #i )
      case PKG_gen
      solve( !Ltk( 'B', ~uskB ) ▶₂ #i )
        case PKG_gen
        solve( !KU( sign(<'A', 'B', pkAe, na>, ~uskA) ) @ #vk.8 )
          case A_start
          by contradiction /* cyclic */
        next
          case c_sign
          by solve( !KU( ~uskA ) @ #vk.12 )
        qed
      qed
    qed
  next
    case case_2
    by contradiction /* from formulas */
  qed
qed

