theory PQAKE_phase1_replay_fixed

begin

// Function signature and definition of the equational theory E

functions: adec/2, aenc/2, confOf/2, fst/1, hkExpand/2, hkExtract/2,
           hkSalt/4, macOf/2, pair/2, pk/1, sdec/2, senc/2, sign/2, snd/1,
