   In( macOf(hkExpand(hkExtract(hkSalt('A', 'B', na, nb), ss),
                      <'Kconf', 
                       transOf('A', 'B', na, nb, pkAe, aenc(ss, pkAe),
                               sign(<'A', 'B', pkAe, na>, ~uskA),
                               sign(<'B', 'A', nb, aenc(ss, pkAe), na>, ~uskB))
