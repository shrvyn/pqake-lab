lemma key_authentication:
  all-traces
  "∀ na nb ks #i.
    (DoneB( na, nb, ks ) @ #i) ⇒
    (∃ #j. (DoneA( na, nb, ks ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ na nb ks #i.
  (DoneB( na, nb, ks ) @ #i)
 ∧
  ∀ #j. (DoneA( na, nb, ks ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( StB( na, pkAe, nb, ss ) ▶₀ #i )
  case B_accept
  solve( !Ltk( 'A', ~uskA ) ▶₁ #i )
    case PKG_gen
    solve( !Ltk( 'B', ~uskB ) ▶₂ #i )
      case PKG_gen
      solve( !Test( 'B', pB ) ▶₃ #i )
        case Test_payloads
        solve( !KU( sign(<'A', 'B', pkAe, na>, ~uskA) ) @ #vk.9 )
          case A_start
          solve( !KU( macOf(hkExpand(hkExtract(hkSalt('A', 'B', ~na, ~nb), ~ss),
                                     <'Kconf', 
                                      transOf('A', 'B', ~na, ~nb, pk(~skAe), aenc(~ss, pk(~skAe)),
                                              sign(<'A', 'B', pk(~skAe), ~na>, ~uskA),
                                              sign(<'B', 'A', ~nb, aenc(~ss, pk(~skAe)), ~na>, ~uskB))
                                     >),
                            confOf(transOf('A', 'B', ~na, ~nb, pk(~skAe), aenc(~ss, pk(~skAe)),
                                           sign(<'A', 'B', pk(~skAe), ~na>, ~uskA),
                                           sign(<'B', 'A', ~nb, aenc(~ss, pk(~skAe)), ~na>, ~uskB)),
                                   macOf(hkExpand(hkExtract(hkSalt('A', 'B', ~na, ~nb), ~ss),
                                                  <'Kconf', 
                                                   transOf('A', 'B', ~na, ~nb, pk(~skAe),
                                                           aenc(~ss, pk(~skAe)),
                                                           sign(<'A', 'B', pk(~skAe), ~na>, ~uskA),
                                                           sign(<'B', 'A', ~nb, aenc(~ss, pk(~skAe)), ~na>,
                                                                ~uskB))
                                                  >),
                                         transOf('A', 'B', ~na, ~nb, pk(~skAe), aenc(~ss, pk(~skAe)),
                                                 sign(<'A', 'B', pk(~skAe), ~na>, ~uskA),
                                                 sign(<'B', 'A', ~nb, aenc(~ss, pk(~skAe)), ~na>, ~uskB)))))
                 ) @ #vk.1 )
            case A_finish
            by contradiction /* from formulas */
          next
            case c_macOf
            solve( !KU( hkExpand(hkExtract(hkSalt('A', 'B', ~na, ~nb), ~ss),
                                 <'Kconf', 
                                  transOf('A', 'B', ~na, ~nb, pk(~skAe), aenc(~ss, pk(~skAe)),
                                          sign(<'A', 'B', pk(~skAe), ~na>, ~uskA),
                                          sign(<'B', 'A', ~nb, aenc(~ss, pk(~skAe)), ~na>, ~uskB))
                                 >)
                   ) @ #vk.10 )
              case c_hkExpand
              solve( !KU( confOf(transOf('A', 'B', ~na, ~nb, pk(~skAe),
                                         aenc(~ss, pk(~skAe)), sign(<'A', 'B', pk(~skAe), ~na>, ~uskA),
                                         sign(<'B', 'A', ~nb, aenc(~ss, pk(~skAe)), ~na>, ~uskB)),
                                 macOf(hkExpand(hkExtract(hkSalt('A', 'B', ~na, ~nb), ~ss),
                                                <'Kconf', 
                                                 transOf('A', 'B', ~na, ~nb, pk(~skAe), aenc(~ss, pk(~skAe)),
                                                         sign(<'A', 'B', pk(~skAe), ~na>, ~uskA),
                                                         sign(<'B', 'A', ~nb, aenc(~ss, pk(~skAe)), ~na>,
                                                              ~uskB))
                                                >),
                                       transOf('A', 'B', ~na, ~nb, pk(~skAe), aenc(~ss, pk(~skAe)),
                                               sign(<'A', 'B', pk(~skAe), ~na>, ~uskA),
                                               sign(<'B', 'A', ~nb, aenc(~ss, pk(~skAe)), ~na>, ~uskB))))
                     ) @ #vk.11 )
                case c_confOf
                solve( !KU( hkExtract(hkSalt('A', 'B', ~na, ~nb), ~ss) ) @ #vk.12 )
                  case c_hkExtract
                  solve( !KU( ~ss ) @ #vk.18 )
                    case B_accept
                    by solve( !KU( ~skAe ) @ #vk.19 )
                  qed
                qed
              qed
            qed
          qed
        next
          case c_sign
          by solve( !KU( ~uskA ) @ #vk.13 )
        qed
      qed
    qed
  qed
qed

lemma key_authentication_inj [use_induction]:
