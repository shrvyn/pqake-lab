rule (modulo E) PKG_gen:
   [ Fr( ~uskA ), Fr( ~uskB ) ]
  --[ LtkGen( 'A', ~uskA ), LtkGen( 'B', ~uskB ) ]->
   [ !Ltk( 'A', ~uskA ), !Ltk( 'B', ~uskB ) ]

  /* has exactly the trivial AC variant */

restriction one_key_per_identity:
  "∀ id k1 k2 #i #j.
    ((LtkGen( id, k1 ) @ #i) ∧ (LtkGen( id, k2 ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ id k1 k2 #i #j.
    ((LtkGen( id, k1 ) @ #i) ∧ (LtkGen( id, k2 ) @ #j)) ⇒ (#i = #j)"
  */

restriction one_accept_per_M1:
  "∀ na #i #j. ((SeenM1( na ) @ #i) ∧ (SeenM1( na ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ na #i #j. ((SeenM1( na ) @ #i) ∧ (SeenM1( na ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) Test_payloads:
   [ Fr( ~pA ), Fr( ~pB ) ]
  --[ CreatedPayload( 'A', ~pA ), CreatedPayload( 'B', ~pB ) ]->
   [ !Test( 'A', ~pA ), !Test( 'B', ~pB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) A_start:
   [ Fr( ~na ), Fr( ~skAe ), !Ltk( 'A', ~uskA ) ]
  --[ StartA( ~na, pk(~skAe) ) ]->
   [
   Out( <'A', 'B', pk(~skAe), ~na, sign(<'A', 'B', pk(~skAe), ~na>, ~uskA)>
   ),
   StA( ~na, ~skAe )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_accept:
   [
   In( <'A', 'B', pkAe, na, sign(<'A', 'B', pkAe, na>, ~uskA)> ),
   !Ltk( 'A', ~uskA ), !Ltk( 'B', ~uskB ), Fr( ~nb ), Fr( ~ss )
   ]
  --[ AcceptB( na, pkAe, ~nb ), SeenM1( na ) ]->
   [
   Out( <~nb, aenc(~ss, pkAe), 
         sign(<'B', 'A', ~nb, aenc(~ss, pkAe), na>, ~uskB)>
   ),
   Out( macOf(hkExpand(hkExtract(hkSalt('A', 'B', na, ~nb), ~ss),
                       <'Kconf', 
                        transOf('A', 'B', na, ~nb, pkAe, aenc(~ss, pkAe),
                                sign(<'A', 'B', pkAe, na>, ~uskA),
                                sign(<'B', 'A', ~nb, aenc(~ss, pkAe), na>, ~uskB))
                       >),
              transOf('A', 'B', na, ~nb, pkAe, aenc(~ss, pkAe),
                      sign(<'A', 'B', pkAe, na>, ~uskA),
                      sign(<'B', 'A', ~nb, aenc(~ss, pkAe), na>, ~uskB)))
   ),
   StB( na, pkAe, ~nb, ~ss )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) B_finish:
   [
