/*
guarded formula characterizing all counter-examples:
"∃ na nb ks #i.
  (DoneB( na, nb, ks ) @ #i)
 ∧
  ∀ #j.
   (DoneA( na, nb, ks ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨ (∃ #k. (DoneB( na, nb, ks ) @ #k) ∧ ¬(#i = #k)))"
*/
