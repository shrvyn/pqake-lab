(****************************************************************************
 * P.Q.A.K.E. v1, phases 2-3 : the AMENDED key schedule of eq 4-31..4-33.
 *
 * pqake_ratchet.pv models the schedule as ch.4 first wrote it: eq 4-32/4-33 seed
 * epoch e's chain keys from the root key RK_e, and eq 5-6 keeps RK_e inside the
 * scraped message state.  The two together are finding F5 - the scrape re-derives
 * the whole epoch, backwards as well as forwards (attacker(pt20) is false there).
 *
 * This file models the repair that lab/proto.py now implements, and only that:
 * the refresh of epoch e produces an intermediate PRK_e = Extract(RK_{e-1},
 * ss_e || e || TH_e), from which the root key RK_e and the two chain keys are
 * derived as separate branches.  RK_e stays in the scrape set - the protocol
 * needs it for the next refresh - but it is no longer the seed of the chains, so
 * a memory read cannot walk the epoch back to its first message key.
 *
 *   attacker(pt10) -> NOT reachable   (PFS across epochs, unchanged)
 *   attacker(pt20) -> NOT reachable   (was reachable in pqake_ratchet.pv)
 *   attacker(pt30) -> NOT reachable   (PCS after one refresh, unchanged)
 *   attacker(kra)  -> NOT reachable   (refresh unforgeability, unchanged)
 *
 * What the scrape still buys the adversary, and what the text now states as the
 * residual: the live chain key of the revealed epoch, hence the messages of that
 * epoch that come after the exposure point, until the next refresh replaces the
 * root.  That is ChainState's reach, not RootState's, and it is why the design
 * keeps an asymmetric ratchet above the symmetric one.
 ****************************************************************************)

free c: channel.

type kemsk.
type kempk.
type kemct.
type ss.

(* ---------- KDF tree of eq 4-31..4-35 as amended: one-way random oracle ------- *)

fun rootKdf(bitstring, ss, nat, bitstring): bitstring.   (* PRK_e = Extract(RK_{e-1}, ss_e||e||TH) *)
fun rootOut(bitstring): bitstring.                       (* RK_e  = Expand(PRK_e, RootKey)  eq 4-31 *)
fun sendChain(bitstring, nat): bitstring.                (* CK^send_e = Expand(PRK_e, SendKeys) eq 4-32 *)
fun recvChain(bitstring, nat): bitstring.                (* CK^recv_e = Expand(PRK_e, RecvKeys) eq 4-33 *)
fun msgKey(bitstring, nat, nat): bitstring.              (* MK_{e,j}   eq 4-34 *)
fun nextChain(bitstring, nat, nat): bitstring.           (* CK_{j+1}   eq 4-35 *)
fun thStep(bitstring, nat, kempk, kemct): bitstring.     (* TH_e       eq 4-31 *)

(* ---------- AES-256-GCM (eq 4-37) and the refresh MAC (eq 4-26, 4-29) ---------- *)

fun aead(bitstring, bitstring, bitstring): bitstring.    (* plaintext, MK, AD *)
reduc forall p: bitstring, a: bitstring, k: bitstring;
      aeadDec(aead(p, k, a), k, a) = p.

fun macr(bitstring, bitstring): bitstring.               (* HMAC under KRA *)
reduc forall k: bitstring, m: bitstring; checkmacr(macr(k, m), k) = m.

(* ---------- per-epoch ML-KEM (eq 4-24, 4-28, 4-30) ---------- *)

fun kemPK(kemsk): kempk.
fun kemEncap(ss, kempk): kemct.
reduc forall s0: ss, k: kemsk; kemDecap(kemEncap(s0, kemPK(k)), k) = s0.

(* ---------- material phase 1 left behind (eq 4-14, 4-15, 4-22) ---------- *)

free idA, idB: bitstring.
free rk0: bitstring [private].
free kra: bitstring [private].
free th0: bitstring.
free pt10, pt20, pt21, pt30: bitstring [private].

(* ---------- the four statements ---------- *)

query attacker(pt10).          (* PFS across epochs *)
query attacker(pt20).          (* PFS inside the revealed epoch - the F5 question *)
query attacker(pt30).          (* PCS after one refresh *)
query attacker(kra).           (* refresh unforgeability *)

(* ---------- honest responder B: one reply per MsgA (eq 4-27..4-30) ---------- *)

let responder =
	in(c, (e: nat, pke: kempk, macA: bitstring));
	let back = checkmacr(macA, kra) in
	if back = (idA, idB, e, pke) then
	new s0: ss;
	let ct = kemEncap(s0, pke) in
	out(c, (e, ct, macr(kra, (e, ct, macA)))).

(* ---------- sender A: three epochs, one state scrape between 2 and 3 ---------- *)

let sender =
	(* ---- epoch 1 ---- *)
	new sk1: kemsk;
	let pk1 = kemPK(sk1) in
	out(c, (1, pk1, macr(kra, (idA, idB, 1, pk1))));
	in(c, (ct1: kemct, macB1: bitstring));
	let ok1 = checkmacr(macB1, kra) in
	if ok1 = (1, ct1, macr(kra, (idA, idB, 1, pk1))) then
	let ss1 = kemDecap(ct1, sk1) in
	let th1 = thStep(th0, 1, pk1, ct1) in
	let prk1 = rootKdf(rk0, ss1, 1, th1) in
	let rk1 = rootOut(prk1) in
	let ck1 = sendChain(prk1, 1) in
	out(c, (1, 0, aead(pt10, msgKey(ck1, 1, 0), th1)));
	(* ---- epoch 2 ---- *)
	new sk2: kemsk;
	let pk2 = kemPK(sk2) in
	out(c, (2, pk2, macr(kra, (idA, idB, 2, pk2))));
	in(c, (ct2: kemct, macB2: bitstring));
	let ok2 = checkmacr(macB2, kra) in
	if ok2 = (2, ct2, macr(kra, (idA, idB, 2, pk2))) then
	let ss2 = kemDecap(ct2, sk2) in
	let th2 = thStep(th1, 2, pk2, ct2) in
	let prk2 = rootKdf(rk1, ss2, 2, th2) in
	let rk2 = rootOut(prk2) in
	let ck2 = sendChain(prk2, 2) in
	let ck2b = nextChain(ck2, 2, 0) in
	out(c, (2, 0, aead(pt20, msgKey(ck2, 2, 0), th2)));
	let ck2c = nextChain(ck2b, 2, 1) in
	out(c, (2, 1, aead(pt21, msgKey(ck2b, 2, 1), th2)));
	(* ============ ACCE StateReveal(message_state), eq 5-6 ============ *)
	(* RK_e is in the scrape, exactly as the state table says; after the amendment
	   it is a sibling branch of PRK_e and no longer seeds the chains. *)
	out(c, (rk2, ck2c, recvChain(prk2, 2), th2, 2, 2));
	(* ---- epoch 3: the refresh that has to restore security ---- *)
	new sk3: kemsk;
	let pk3 = kemPK(sk3) in
	out(c, (3, pk3, macr(kra, (idA, idB, 3, pk3))));
	in(c, (ct3: kemct, macB3: bitstring));
	let ok3 = checkmacr(macB3, kra) in
	if ok3 = (3, ct3, macr(kra, (idA, idB, 3, pk3))) then
	let ss3 = kemDecap(ct3, sk3) in
	let th3 = thStep(th2, 3, pk3, ct3) in
	let prk3 = rootKdf(rk2, ss3, 3, th3) in
	let rk3 = rootOut(prk3) in
	let ck3 = sendChain(prk3, 3) in
	out(c, (3, 0, aead(pt30, msgKey(ck3, 3, 0), th3))).

process
	(!responder | sender)
