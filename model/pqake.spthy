theory PQAKE_phase1
begin

/* -------------------------------------------------------------------------
 * P.Q.A.K.E. v1 - phase 1 (thesis eq 4-4 .. 4-21) exactly as written, i.e.
 * BEFORE the F2 repair.  Tamarin port of model/pqake.pv.
 *
 * Run:  tamarin-prover --prove pqake.spthy
 *       (in CI: .github/workflows/tamarin.yml; transcripts land in
 *        model/logs/pqake.tamarin.log)
 * Read: model/ACCE-PQAKE.md, FINDINGS.md (finding F2)
 *
 * Modelling decisions - one for one with model/pqake.pv, so that the two tools
 * can be compared lemma by lemma:
 *
 *   - The IBS of eq 4-1..4-4 is idealised as a deterministic EUF-CMA signature
 *     scheme (built-in theory `signing`).  Identity-based key derivation
 *     (usk = h_ID * s1) is ring arithmetic and cannot be expressed in a free
 *     algebra, so the master-secret break F1 and the escrow claim D1 are
 *     neither provable nor refutable here; they are established executably
 *     (lab/claims.py::c2, ::d1) and symbolically only in pqake_pkg_escrow.pv.
 *   - ML-KEM-512 (FIPS 203) is an IND-CCA KEM, idealised exactly as the
 *     ProVerif model idealises it (reduc
 *     kemDecap(kemEncap(s0, kemPK(k)), k) = s0): encapsulation draws a fresh
 *     secret and emits a ciphertext that only the matching secret key
 *     recovers, so it is the built-in asymmetric-encryption theory - the
 *     ciphertext is aenc{ ss0 }pkAe and decapsulation is pattern matching
 *     under pk(skAe).  FIPS 203's implicit rejection is the case where the
 *     pattern does not match: the rule simply cannot be applied.
 *   - SHA3-256, HKDF and HMAC are free constructors: no equations, so equality
 *     of two derived terms forces equality of their inputs (random-oracle
 *     idealisation, same as ProVerif's one-way constructors).
 *   - na, skAe and ss0 are fresh names, i.e. the model gives the protocol every
 *     nonce and ephemeral key it asks for.  What it does NOT give B is any
 *     means of noticing that an M1 it has already accepted is being handed to
 *     it again - which is finding F2.
 *   - Long-term identity keys are honest by construction: PKG_gen is the only
 *     rule that creates them, no rule ever outputs one (so there is no reveal
 *     oracle here, mirroring `free uskA/uskB` in the ProVerif process and the
 *     "honest long-term keys" row of table 5-5), and one_key_per_identity keeps
 *     the model to the single key pair the ProVerif process has.
 * ------------------------------------------------------------------------- */

builtins: signing, symmetric-encryption, asymmetric-encryption

/* ---------- SHA3-256 / HKDF / HMAC (eq 4-11 .. 4-20) ---------- */

functions:
  hkSalt/4,      //  salt = H(IDA | IDB | NA | NB)                       eq 4-12
  hkExtract/2,   //  PRK0 = Extract(salt, ss0)                           eq 4-13
  hkExpand/2,    //  Kconf, Ksess                                        eq 4-14..4-19
  macOf/2,       //  HMAC over the transcript                            eq 4-20
  confOf/2,      //  th1 = H(TH | MACB), the input of MACA               eq 4-20
  transOf/8      //  TH  = H(IDA|IDB|NA|NB|pkAe|ct0|sigmaA|sigmaB)       eq 4-11

/* no equations: every symbol above is a free constructor */

/* ---------- PKG: one honest identity key per role (eq 4-1..4-4) ---------- */

rule PKG_gen:
  [ Fr( ~uskA ), Fr( ~uskB) ]
  -->
  [ !Ltk( 'A', ~uskA ), !Ltk( 'B', ~uskB ) ]

restriction one_key_per_identity:
  "All id k1 k2 #i #j.
     !Ltk( id, k1 ) @ i & !Ltk( id, k2 ) @ j
     ==>
     #i = #j"

/* The two payloads the test session protects (ProVerif: free payloadA/payloadB). */
rule Test_payloads:
  [ Fr( ~pA ), Fr( ~pB ) ]
  --[ CreatedPayload( 'A', ~pA ), CreatedPayload( 'B', ~pB ) ]->
  [ !Test( 'A', ~pA ), !Test( 'B', ~pB ) ]

/* ---------- initiator A: eq 4-4, 4-5 ---------- */

rule A_start:
  let pkAe = pk( ~skAe )
      m1   = < 'A', 'B', pkAe, ~na, sign{ 'A', 'B', pkAe, ~na }~uskA >
  in
    [ Fr( ~na )
    , Fr( ~skAe )
    , !Ltk( 'A', ~uskA )
    ]
  --[ StartA( ~na, pkAe ) ]->
    [ Out( m1 )
    , StA( ~na, ~skAe )
    ]

/* ---------- responder B: eq 4-6, 4-7, 4-8, and B's half of 4-11..4-20 ---------- */

rule B_accept:
  let ct0   = aenc{ ~ss }pkAe
      sigA  = sign{ 'A', 'B', pkAe, na }~uskA
      sigB  = sign{ 'B', 'A', ~nb, ct0, na }~uskB
      th    = transOf( 'A', 'B', na, ~nb, pkAe, ct0, sigA, sigB )
      prk   = hkExtract( hkSalt( 'A', 'B', na, ~nb ), ~ss )
      kconf = hkExpand( prk, <'Kconf', th> )
      m1    = < 'A', 'B', pkAe, na, sigA >
      m2    = < ~nb, ct0, sigB >
  in
    [ In( m1 )
    , !Ltk( 'A', ~uskA )
    , !Ltk( 'B', ~uskB )
    , Fr( ~nb )
    , Fr( ~ss )
    ]
  --[ AcceptB( na, pkAe, ~nb ) ]->
    [ Out( m2 )
    , Out( macOf( kconf, th ) )
    , StB( na, pkAe, ~nb, ~ss )
    ]

/* ---------- B: MACA check, eq 4-20; then the first protected message ---------- */

rule B_finish:
  let ct0   = aenc{ ss }pkAe
      sigA  = sign{ 'A', 'B', pkAe, na }~uskA
      sigB  = sign{ 'B', 'A', nb, ct0, na }~uskB
      th    = transOf( 'A', 'B', na, nb, pkAe, ct0, sigA, sigB )
      prk   = hkExtract( hkSalt( 'A', 'B', na, nb ), ss )
      kconf = hkExpand( prk, <'Kconf', th> )
      ksess = hkExpand( prk, <'Ksess', th> )
      macB  = macOf( kconf, th )
      macA  = macOf( kconf, confOf( th, macB ) )
  in
    [ StB( na, pkAe, nb, ss )
    , !Ltk( 'A', ~uskA )
    , !Ltk( 'B', ~uskB )
    , !Test( 'B', pB )
    , In( macA )
    ]
  --[ DoneB( na, nb, ksess ) ]->
    [ Out( senc{ 'B', pB }ksess )
    ]

/* ---------- initiator A: eq 4-9, 4-10, 4-11..4-20 ---------- */

rule A_finish:
  let pkAe  = pk( skAe )
      ct0   = aenc{ ss0 }pkAe
      sigA  = sign{ 'A', 'B', pkAe, na }~uskA
      sigB  = sign{ 'B', 'A', nb, ct0, na }~uskB
      th    = transOf( 'A', 'B', na, nb, pkAe, ct0, sigA, sigB )
      prk   = hkExtract( hkSalt( 'A', 'B', na, nb ), ss0 )
      kconf = hkExpand( prk, <'Kconf', th> )
      ksess = hkExpand( prk, <'Ksess', th> )
      macB  = macOf( kconf, th )
      m2    = < nb, ct0, sigB >
  in
    [ StA( na, skAe )
    , !Ltk( 'A', ~uskA )
    , !Ltk( 'B', ~uskB )
    , !Test( 'A', pA )
    , In( m2 )
    , In( macB )
    ]
  --[ DoneA( na, nb, ksess ) ]->
    [ Out( macOf( kconf, confOf( th, macB ) ) )
    , Out( senc{ 'A', pA }ksess )
    ]

/* =========================================================================
 * Properties - the queries of pqake.pv, plus a consistency check so that a
 * vacuous "holds" cannot be mistaken for a proof.
 * ======================================================================= */

/* Q1 secrecy of what the session key protects, for both roles */
lemma payload_secrecy:
  "All who p #i.
     CreatedPayload( who, p ) @ i
     ==>
     not( Ex #k. K( p ) @ k )"

/* Q2 aliveness: whatever B accepts was started by A with the same NA and pkAe */
lemma aliveness:
  "All na pkAe nb #i.
     AcceptB( na, pkAe, nb ) @ i
     ==>
     ( Ex #j. StartA( na, pkAe ) @ j & j < i )"

/* Q3 injective agreement: one accepted M1 cannot be spent twice.
      This is the statement ProVerif could not decide for the repaired
      handshake; see FINDINGS.md F2 and model/limitation_table_else.pv. */
lemma injective_agreement [use_induction]:
  "All na pkAe nb #i.
     AcceptB( na, pkAe, nb ) @ i
     ==>
     ( Ex #j. StartA( na, pkAe ) @ j & j < i
       & not( Ex nb2 #i2. AcceptB( na, pkAe, nb2 ) @ i2 & not( #i = #i2 ) ) )"

/* The second conjunct of Q3 on its own, so that a falsification can be
   attributed to the missing freshness test rather than to the agreement part. */
lemma no_double_accept [use_induction]:
  "All na pkAe nb1 nb2 #i #j.
     AcceptB( na, pkAe, nb1 ) @ i & AcceptB( na, pkAe, nb2 ) @ j
     ==>
     #i = #j"

/* The same statement without the use_induction attribute.  Control for the
   restriction experiment (model/RestrictionProbeBefore.spthy): this theory has
   no freshness test, so no formulation of the lemma can be verified, and if
   pqake_replay_fixed.spthy's non-inductive version comes back verified while
   the inductive one is falsified, the difference is how 1.12 handles
   restrictions under induction, not the protocol. */
lemma no_double_accept_plain:
  "All na pkAe nb1 nb2 #i #j.
     AcceptB( na, pkAe, nb1 ) @ i & AcceptB( na, pkAe, nb2 ) @ j
     ==>
     #i = #j"

/* Q4 key authentication in the direction the channel can support */
lemma key_authentication:
  "All na nb ks #i.
     DoneB( na, nb, ks ) @ i
     ==>
     ( Ex #j. DoneA( na, nb, ks ) @ j & j < i )"

/* Q5 the same, injective: one finished B session per finished A session */
lemma key_authentication_inj [use_induction]:
  "All na nb ks #i.
     DoneB( na, nb, ks ) @ i
     ==>
     ( Ex #j. DoneA( na, nb, ks ) @ j & j < i
       & not( Ex #k. DoneB( na, nb, ks ) @ k & not( #i = #k ) ) )"

/* Q6 aliveness of B for A's view: A can only finish if B accepted that very M1 */
lemma responder_aliveness:
  "All na nb ks #i.
     DoneA( na, nb, ks ) @ i
     ==>
     ( Ex #j pkAe. AcceptB( na, pkAe, nb ) @ j )"

/* Consistency check: the lemmas above are not vacuous - honest sessions do
   complete, and both sides derive the same Ksess. */
lemma handshake_possible:
  exists-trace
  "Ex na nb ks #i #j.
     DoneA( na, nb, ks ) @ i & DoneB( na, nb, ks ) @ j"

end
